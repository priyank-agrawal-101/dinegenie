# Core API configuration
APP_SERVICE_NAME=restaurant-recommendation-api
APP_ENVIRONMENT=development
APP_LOG_LEVEL=INFO
APP_API_HOST=0.0.0.0
APP_API_PORT=8000
APP_DATABASE_URL=sqlite:///./runtime-data/restaurants.db
APP_DATABASE_BUSY_TIMEOUT_SECONDS=5
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_MAX_REQUEST_BODY_BYTES=16384
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_API_REQUESTS_PER_WINDOW=120
APP_RECOMMENDATION_REQUESTS_PER_WINDOW=30
APP_LLM_REQUESTS_PER_WINDOW=10

# Pinned dataset source
APP_DATASET_REPOSITORY=ManikaSaini/zomato-restaurant-recommendation
APP_DATASET_REVISION=5738e9eda2fad49ad51c6e0ed26e761d9b947133

# Deterministic recommendation policy
APP_BUDGET_LOW_MAX=600
APP_BUDGET_MEDIUM_MAX=1500
APP_RANKING_RATING_WEIGHT=0.35
APP_RANKING_CUISINE_WEIGHT=0.30
APP_RANKING_BUDGET_WEIGHT=0.20
APP_RANKING_PREFERENCE_WEIGHT=0.15
APP_CANDIDATE_QUERY_LIMIT=200
APP_RERANK_CANDIDATE_LIMIT=20
APP_METADATA_CACHE_SECONDS=30
APP_RECOMMENDATION_TIMEOUT_SECONDS=10
APP_RECOMMENDATION_QUEUE_TIMEOUT_SECONDS=0.25
APP_RECOMMENDATION_CONCURRENCY_LIMIT=32

# Optional LLM integration; deterministic mode requires no API key
APP_LLM_ENABLED=false
APP_LLM_PROVIDER=groq
APP_LLM_MODEL=
APP_LLM_TIMEOUT_SECONDS=8
APP_LLM_QUEUE_TIMEOUT_SECONDS=0.25
APP_LLM_CONCURRENCY_LIMIT=4
APP_LLM_MAX_COMPLETION_TOKENS=2500
APP_LLM_MAX_PROMPT_TOKENS=24000
APP_LLM_MAX_PROMPT_BYTES=48000
# Use json_schema only for a Groq model with documented strict structured-output support.
APP_LLM_RESPONSE_FORMAT=json_object
APP_LLM_MAX_RETRIES=1
APP_LLM_CIRCUIT_FAILURE_THRESHOLD=3
APP_LLM_CIRCUIT_COOLDOWN_SECONDS=30
# Optional cost estimates: set both to current per-million USD prices for the chosen model.
# APP_LLM_INPUT_USD_PER_MILLION=...
# APP_LLM_OUTPUT_USD_PER_MILLION=...
APP_GROQ_API_KEY=

# Prometheus-compatible operational metrics
APP_METRICS_ENABLED=true
APP_INGESTION_METRICS_FILE=runtime-data/metrics/ingestion.prom

# Browser build; leave empty for same-origin API paths and Vite's local proxy
VITE_API_BASE_URL=
