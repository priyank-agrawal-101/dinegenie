APP_ENVIRONMENT=production
APP_LOG_LEVEL=INFO
APP_API_HOST=127.0.0.1
APP_API_PORT=8000
APP_DATABASE_URL=sqlite:///./runtime-data/production/restaurants.db
APP_DATABASE_BUSY_TIMEOUT_SECONDS=5
APP_CORS_ORIGINS=https://restaurants.example.com
APP_RATE_LIMIT_ENABLED=true
APP_METRICS_ENABLED=true
APP_LLM_ENABLED=true
